rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /usersInfo/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.completedLevels is int
        && request.resource.data.totalSteps is int
        && request.resource.data.totalSize is int
        && request.resource.data.completedLevels >= 0
        && request.resource.data.totalSteps >= 0
        && request.resource.data.totalSize >= 0;
      allow delete: if false;
    }
  }
}
